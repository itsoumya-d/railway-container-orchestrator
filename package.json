{
  "name": "railway-container-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript GraphQL container orchestrator with a deployment doctor: spin containers up and down through a Railway-shaped GraphQL API, then diagnose failures from build logs.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "cli": "node dist/src/client.js",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
